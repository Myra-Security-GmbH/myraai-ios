# config/Dockerfile.presidio
# Presidio Analyzer with GLiNER multilingual NER + lingua language detection.
# NER engine: urchade/gliner_multi_pii-v1 (English, German, French, Spanish, Italian, Portuguese).
# Pattern PII: Presidio regex recognisers (email, IBAN, credit card, phone, …).
# Language detection: lingua-language-detector (en/de auto-detect, no runtime network access).
#
# Build:  docker build -f config/Dockerfile.presidio -t aig-presidio-analyzer .
# Run:    see run-presidio.sh

FROM nvidia/cuda:13.1.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# PyTorch with CUDA 12.4 wheels — forward-compatible with CUDA 12/13 host drivers.
RUN pip3 install --no-cache-dir --index-url https://download.pytorch.org/whl/cu124 torch

# Presidio + spaCy (tokenisation only) + GLiNER + lingua + flask
RUN pip3 install --no-cache-dir \
    presidio-analyzer \
    "spacy>=3.8" \
    gliner \
    lingua-language-detector \
    flask

# Minimal spaCy model — used only for tokenisation by Presidio's regex recognisers.
# NER is handled entirely by GLiNER; the large en_core_web_lg / de_core_news_lg are no longer needed.
RUN python3 -m spacy download en_core_web_sm

# Pre-bake GLiNER multilingual PII model so there is no network access at runtime.
ENV HF_HOME=/opt/hf-cache
RUN mkdir -p /opt/hf-cache \
    && python3 -c "from gliner import GLiNER; GLiNER.from_pretrained('urchade/gliner_multi_pii-v1')" \
    && chmod -R a+rX /opt/hf-cache

ENV PRESIDIO_SUPPORTED_LANGUAGES=en,de,fr,es,it,pt

# Create a non-root user.  HF_HOME is world-readable so no ownership change needed.
RUN useradd --no-create-home --shell /usr/sbin/nologin --uid 1000 presidio

ENV HOME=/opt/hf-cache

COPY config/presidio_entrypoint.py /entrypoint.py
USER presidio
EXPOSE 3000
CMD ["python3", "/entrypoint.py"]
