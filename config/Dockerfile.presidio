# config/Dockerfile.presidio
# Presidio Analyzer with English and German spaCy models baked in.
# Runs on GPU via cupy-cuda13x (requires CUDA 13.x driver on host).
#
# Build:  docker build -f config/Dockerfile.presidio -t aig-presidio-analyzer .
# Run:    see run-presidio.sh

FROM nvidia/cuda:13.1.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# presidio + flask server + cupy for CUDA 13.x (bundles cublas/cufft/etc.)
RUN pip3 install --no-cache-dir \
    presidio-analyzer \
    "spacy>=3.8" \
    cupy-cuda13x \
    flask

# Bake in spaCy models — no download at runtime
RUN python3 -m spacy download en_core_web_lg && \
    python3 -m spacy download de_core_news_lg

# Tell Presidio which languages are available
ENV PRESIDIO_SUPPORTED_LANGUAGES=en,de
ENV DEFAULT_MODEL_FOR_LANG_en=en_core_web_lg
ENV DEFAULT_MODEL_FOR_LANG_de=de_core_news_lg

COPY config/presidio_entrypoint.py /entrypoint.py
EXPOSE 3000
CMD ["python3", "/entrypoint.py"]
