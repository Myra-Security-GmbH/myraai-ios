[Unit]
Description=vLLM – Llama Guard 3 8B (GPU 1+2 data-parallel, RTX PRO 6000 Blackwell)
Documentation=https://docs.vllm.ai
After=network.target
Wants=network.target

[Service]
Type=simple
User=vllm
Group=vllm
WorkingDirectory=/home/vllm

# ── Model cache and Python environment ────────────────────────────────────────
Environment=HF_HOME=/opt/models/huggingface
Environment=PATH=/home/vllm/.vllm/bin:/usr/local/cuda/bin:/usr/bin:/bin

# ── GPU selection: both Blackwell GPUs (NUMA node 1, same PCIe root) ─────────
Environment=CUDA_VISIBLE_DEVICES=1,2
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID

# ── Multi-GPU tensor parallel (NCCL P2P over PCIe, no NVLink) ────────────────
Environment=VLLM_WORKER_MULTIPROC_METHOD=spawn
Environment=NCCL_IB_DISABLE=1

# ── HuggingFace download ──────────────────────────────────────────────────────
Environment=HF_HUB_CACHE=/opt/models/huggingface/hub
# Disable xet protocol (causes 416 errors on large shards)
Environment=HF_HUB_DISABLE_XET=1

# Gated model — HF_TOKEN must be set in /etc/vllm/secrets.env
EnvironmentFile=/etc/vllm/secrets.env

# ── Compilation cache (saves several minutes on restart after first run) ──────
Environment=TORCHINDUCTOR_CACHE_DIR=/opt/models/cache/inductor
Environment=VLLM_CACHE_ROOT=/opt/models/cache/vllm

# ── Loading optimizations ─────────────────────────────────────────────────────
Environment=OMP_NUM_THREADS=16
Environment=SAFETENSORS_FAST_GPU=1
Environment=PYTORCH_ALLOC_CONF=max_split_size_mb:512,expandable_segments:True

# ── vLLM serve ────────────────────────────────────────────────────────────────
ExecStart=/home/vllm/.vllm/bin/vllm serve meta-llama/Llama-Guard-3-8B \
    \
    # Parallelism — each GPU runs a full model replica, no cross-GPU comms
    --tensor-parallel-size 1 \
    --data-parallel-size 2 \
    \
    # Precision
    --dtype bfloat16 \
    --load-format safetensors \
    \
    # Memory — 0.80 × 94.97 GiB = 75.97 GiB/GPU (Ollama residue holds ~17 GiB on GPU 2)
    --gpu-memory-utilization 0.80 \
    \
    # Context / throughput
    --max-model-len 4096 \
    --max-num-seqs 512 \
    --max-num-batched-tokens 32768 \
    --enable-chunked-prefill \
    \
    # Prefix caching — the ~400-token Llama Guard system prompt is
    # identical on every request; caching it cuts TTFT ~30-40% under load
    --enable-prefix-caching \
    \
    # API
    --host 127.0.0.1 \
    --port 8083 \
    --served-model-name llama-guard-3-8b \
    \
    # Misc
    --download-dir /opt/models/huggingface/hub \
    --compilation-config '{"cache_dir":"/opt/models/cache/vllm"}' \
    --enforce-eager \
    --disable-log-requests

# ── Process limits ────────────────────────────────────────────────────────────
LimitNOFILE=65536
LimitMEMLOCK=infinity

# ── Restart policy ────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=30

# Model loading on Blackwell takes several minutes on first run
TimeoutStartSec=600
TimeoutStopSec=60

# ── Logging ───────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vllm-llama-guard

[Install]
WantedBy=multi-user.target
