[Unit]
Description=vLLM – MinerU2.5 1.2B document parsing (GPU 1, port 8084)
Documentation=https://github.com/opendatalab/MinerU
After=network.target
Wants=network.target

[Service]
Type=simple
User=vllm
Group=vllm
WorkingDirectory=/home/vllm

# ── Model cache and Python environment ────────────────────────────────────────
Environment=HF_HOME=/opt/models/huggingface
Environment=HF_HUB_CACHE=/opt/models/huggingface/hub
Environment=HF_HUB_DISABLE_XET=1
Environment=PATH=/home/vllm/.vllm/bin:/usr/local/cuda/bin:/usr/bin:/bin

# ── GPU selection: GPU 1 only ─────────────────────────────────────────────────
Environment=CUDA_VISIBLE_DEVICES=1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID

# ── HuggingFace download ──────────────────────────────────────────────────────
# Gated model — HF_TOKEN must be set in /etc/vllm/secrets.env
EnvironmentFile=/etc/vllm/secrets.env

# ── Compilation cache (separate from llama-guard) ─────────────────────────────
Environment=TORCHINDUCTOR_CACHE_DIR=/opt/models/cache/inductor-mineru
Environment=VLLM_CACHE_ROOT=/opt/models/cache/vllm-mineru

# ── Loading optimisations ─────────────────────────────────────────────────────
Environment=OMP_NUM_THREADS=8
Environment=SAFETENSORS_FAST_GPU=1
Environment=PYTORCH_ALLOC_CONF=max_split_size_mb:512,expandable_segments:True

# ── vLLM serve ────────────────────────────────────────────────────────────────
ExecStart=/home/vllm/.vllm/bin/vllm serve opendatalab/MinerU2.5-2509-1.2B \
    \
    # MinerU structured-output logits processor (vLLM ≥ 0.10.1)
    --logits-processors mineru_vl_utils:MinerULogitsProcessor \
    \
    # Parallelism — single GPU
    --tensor-parallel-size 1 \
    \
    # Precision
    --dtype bfloat16 \
    --load-format safetensors \
    \
    # Memory — 0.17 × 94.97 GiB ≈ 16 GiB (leaves room for llama-guard at 0.80)
    --gpu-memory-utilization 0.17 \
    \
    # Context / throughput
    --max-model-len 4096 \
    --max-num-seqs 8 \
    \
    # Prefix caching — system prompt is identical on every request
    --enable-prefix-caching \
    \
    # API
    --host 127.0.0.1 \
    --port 8084 \
    --served-model-name mineru2 \
    \
    # Misc
    --download-dir /opt/models/huggingface/hub \
    --compilation-config '{"cache_dir":"/opt/models/cache/vllm-mineru"}' \
    --enforce-eager \
    --disable-log-requests

# ── Process limits ────────────────────────────────────────────────────────────
LimitNOFILE=65536
LimitMEMLOCK=infinity

# ── Restart policy ────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=60

# ── Logging ───────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vllm-mineru2

[Install]
WantedBy=multi-user.target
