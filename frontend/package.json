{
  "name": "ai-gateway-admin",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const m=[];['VITE_ADMIN_URL','VITE_AUTH_URL','VITE_GATEWAY_URL','VITE_DOCS_URL'].forEach(v=>{if(!process.env[v])m.push(v)});if(m.length){console.error('\\n\\x1b[31m✖ Build aborted: missing required env vars:\\x1b[0m\\n'+m.map(v=>'  '+v).join('\\n')+'\\n\\n\\x1b[33m  Run: bash build_frontend.sh\\x1b[0m\\n');process.exit(1)}\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@myraui/badge": "^3.0.4",
    "@myraui/core": "^3.0.3",
    "@myraui/styles": "^1.1.0",
    "@myraui/utils": "^2.1.3",
    "classnames": "^2.3.2",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.15.0",
    "recharts": "^3.5.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": ">=22.0.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "sass": "^1.97.2",
    "sass-embedded": "^1.97.2",
    "typescript": "^4.9.5",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@3.8.7"
}
