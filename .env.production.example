# AI Gateway — production secrets template
# Copy to .env.production and fill in real values.
# Keep .env.production private (chmod 600). Never commit it to git.
# Sourced automatically by run_docker_production.sh.

# Encryption key for BYOK provider secrets at rest (AES-256).
# Generate a new one with:  openssl rand -hex 32
AIG_MASTER_KEY="CHANGEME"

# JWT signing secret for admin session tokens.
# Generate a new one with:  openssl rand -hex 32
AIG_JWT_SECRET="CHANGEME"

# MariaDB password for the 'gateway' user.
AIG_MYSQL_PASS="gateway"

# ── Email / SMTP ──────────────────────────────────────────────────────────────

# From-address used in login OTP emails.
AIG_OTP_FROM_EMAIL="noreply@example.com"

# SMTP relay for outgoing OTP emails.
# Leave AIG_SMTP_HOST empty to disable email (OTP codes are still stored in DB).
AIG_SMTP_HOST=""
AIG_SMTP_PORT="587"
AIG_SMTP_USER=""
AIG_SMTP_PASS=""

# ── Bootstrap first admin (first start only) ──────────────────────────────────
# Automatically creates an admin user on first startup.
# Has no effect once any admin user exists — safe to leave set.
AIG_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# AIG_BOOTSTRAP_ADMIN_NAME="Admin"

# ── Optional: Google SSO ──────────────────────────────────────────────────────
# Uncomment and fill in to enable "Sign in with Google".
# AIG_GOOGLE_CLIENT_ID=""
# AIG_GOOGLE_CLIENT_SECRET=""
# Redirect URI must be registered in Google Cloud Console:
# AIG_GOOGLE_REDIRECT_URI="https://ai-api-admin.example.com/admin/auth/google/callback"

# ── Optional: Ollama (self-hosted LLM) ────────────────────────────────────────
# OLLAMA_BASE_URL="http://ollama:11434"

# ── Optional: payload logging ─────────────────────────────────────────────────
# Set to "false" to stop storing request/response bodies in the log.
# AIG_LOG_PAYLOADS="true"
