<resources>
    <!--
        Splash screen: navy background with the official Myra Security shield logo.
        postSplashScreenTheme switches to the real app theme after the splash.
    -->
    <style name="Theme.MYRAai" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/myra_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MYRAai.App</item>
    </style>

    <style name="Theme.MYRAai.App" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/myra_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
